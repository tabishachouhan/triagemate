# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

PORT=5000

# LLM API key — using Groq's free API by default (no cost, no card required).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: switch to Claude later once you have API credits — see the
# commented block at the bottom of llm.js for how to swap it in.
# ANTHROPIC_API_KEY=your_claude_api_key_here

# Supabase (for storing session/assessment history)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
